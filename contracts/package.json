{
  "name": "contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "hardhat build && tsc --noEmit",
    "node": "hardhat node",
    "export-abis": "hardhat build && node scripts/export-abis.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "register-creators:local": "hardhat run scripts/register-creators.ts --network localhost",
    "fund:local": "hardhat run scripts/fund-wallets.ts --network localhost",
    "preflight:local": "hardhat run scripts/preflight.ts --network localhost",
    "preflight:sepolia": "hardhat run --build-profile production scripts/preflight.ts --network sepolia",
    "deploy:sepolia": "hardhat run --build-profile production scripts/deploy.ts --network sepolia",
    "register-creators:sepolia": "hardhat run --build-profile production scripts/register-creators.ts --network sepolia",
    "fund:sepolia": "hardhat run --build-profile production scripts/fund-wallets.ts --network sepolia",
    "verify:sepolia": "hardhat run --build-profile production scripts/verify-sepolia.ts --network sepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-typechain": "^3.1.2",
    "@nomicfoundation/hardhat-verify": "^3.1.3",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.20.0",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3"
  }
}
