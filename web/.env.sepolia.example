# Sepolia settings for the organizer's commands (npm run sepolia -- <script>).
# Copy to web/.env.sepolia and fill in. Never commit the filled-in file.
NEXT_PUBLIC_CHAIN_ID=11155111

# Alchemy (or Infura) Sepolia HTTPS endpoint. Keep the key private.
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Supabase: Project Settings → Database → SSL Configuration → Download certificate.
# Paste the PEM text on one line with \n between lines (or as a quoted multi-line value).
DATABASE_SSL_CA=

# The hosted web app's NFT metadata route, used once at deploy time.
NFT_BASE_URI=https://<your-app>.vercel.app/api/nft/

SESSION_TTL_HOURS=12
