# Copy to web/.env.local and fill in. Never commit .env files.
# This application runs ONLY on a local development chain or Ethereum Sepolia.

# Network: 31337 (local Hardhat node) or 11155111 (Sepolia). Any other value is rejected at startup.
NEXT_PUBLIC_CHAIN_ID=31337

# Server-side JSON-RPC endpoint for the chain above.
# Local:   http://127.0.0.1:8545
# Sepolia: https://eth-sepolia.g.alchemy.com/v2/<your-key>   (keep the key out of git)
RPC_URL=http://127.0.0.1:8545

# PostgreSQL connection string.
# DATABASE_URL=postgres://localhost:5432/picard
DATABASE_URL=postgres://postgres:picard_password@postgres:5432/picard

# Participant session lifetime in hours.
SESSION_TTL_HOURS=12

# Hosted Postgres only (e.g. Supabase): the provider's CA certificate (PEM text, "\n" escapes OK),
# so the connection is both encrypted and verified. Leave unset for local Postgres.
# DATABASE_SSL_CA=

# Login cookie "Secure" flag. Default: on in production builds (HTTPS), off in development.
# Set COOKIE_SECURE=false only for a production build served over plain http (Docker on a LAN / bare IP).
# COOKIE_SECURE=
