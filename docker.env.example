# Copy to .env (next to docker-compose.yml) and adjust. Never commit .env.

# The address other devices use to reach this machine:
#   same Wi-Fi: the machine's LAN IP, e.g. 10.42.81.56
#   AWS:        the instance's public IP or DNS name, e.g. 13.233.10.20
PUBLIC_HOST=

# Database password used between the two containers (not exposed outside Docker).
POSTGRES_PASSWORD=change-me

# Leave false unless you put an HTTPS proxy in front (then set true).
COOKIE_SECURE=false
