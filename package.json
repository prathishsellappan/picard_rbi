{
  "name": "picard",
  "private": true,
  "description": "Educational crypto-fraud role-play on a local Ethereum network or Sepolia (test assets only)",
  "workspaces": [
    "web",
    "contracts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "test": "npm run test -w web && npm run test -w contracts",
    "typecheck": "npm run typecheck -w web",
    "db:migrate": "npm run db:migrate -w web",
    "db:seed": "npm run db:seed -w web --",
    "test:contracts": "npm run test -w contracts",
    "indexer": "npm run indexer -w web --",
    "provision": "npm run provision -w web --"
  }
}
